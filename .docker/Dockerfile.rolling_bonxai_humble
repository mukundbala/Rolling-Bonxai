# ============================================================
# .docker/Dockerfile.rolling_bonxai_humble
#
# Two-stage build:
#   deps  — all apt deps, no source (used by devcontainer)
#   build — copies workspace, runs colcon build (used by compose)
#
# Both stages on ROS 2 Humble to match the SITL container so
# DDS discovery works across containers on network_mode: host.
#
# Build from repo root:
#   docker build -f .docker/Dockerfile.rolling_bonxai_humble \
#                --target build -t rolling_bonxai:humble .
# ============================================================

# ── Stage 1: deps ────────────────────────────────────────────
FROM ros:humble-ros-base AS deps

SHELL ["/bin/bash", "-o", "pipefail", "-o", "errexit", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# Add OSRF Gazebo apt key (needed for ros-humble-ros-gz-bridge)
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl lsb-release gnupg && \
    curl https://packages.osrfoundation.org/gazebo.gpg \
         --output /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) \
         signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] \
         http://packages.osrfoundation.org/gazebo/ubuntu-stable \
         $(lsb_release -cs) main" \
         > /etc/apt/sources.list.d/gazebo-stable.list && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    build-essential cmake git wget \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-pip \
    # ROS 2 Humble packages needed by rolling_bonxai_ros
    ros-humble-tf2-ros \
    ros-humble-tf2-eigen \
    ros-humble-sensor-msgs \
    ros-humble-geometry-msgs \
    ros-humble-visualization-msgs \
    ros-humble-pcl-conversions \
    ros-humble-std-srvs \
    ros-humble-rclcpp-components \
    ros-humble-foxglove-bridge \
    # Bag tooling for datasets/ (TartanGround -> MCAP)
    ros-humble-rosbag2 \
    ros-humble-rosbag2-storage-mcap \
    python3-numpy \
    # Experiment pipeline: plots (plot_stats.py), CPU profiling (perf; run_experiments.py --perf)
    # and a GUI to browse the profiles (hotspot; under Wayland run it with QT_QPA_PLATFORM=wayland)
    python3-matplotlib \
    linux-tools-common \
    linux-tools-generic \
    hotspot \
    # Gazebo Harmonic bridge (for /clock topic relay from SITL)
    ros-humble-ros-gz-bridge \
    # C++ dependencies
    libeigen3-dev \
    libpcl-dev \
    libyaml-cpp-dev \
    libboost-all-dev \
    # Debug tools
    gdb \
    # Lets the non-root dev user install packages (rosdep install uses sudo)
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Dataset downloads (datasets/scripts/download_tartanground.py): huggingface_hub only, no torch/CUDA
RUN pip3 install --no-cache-dir "huggingface_hub==1.33.0"

# Ubuntu's `perf` wrapper only runs on Ubuntu kernels (it looks for /usr/lib/linux-tools/$(uname -r));
# point `perf` straight at the installed binary so it also works on other host kernels.
RUN ln -sf "$(ls -d /usr/lib/linux-tools/*/perf | sort -V | tail -1)" /usr/local/bin/perf

RUN rosdep init 2>/dev/null || true && rosdep update

RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc && \
    echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" \
         >> /root/.bashrc

# Non-root dev user, so files created in the bind-mounted repo belong to the host user, not root.
# The devcontainer runs as this user (remoteUser) and remaps its uid to the host's (updateRemoteUserUID).
# Ubuntu 24.04 images already ship `ubuntu` (uid 1000); on 22.04 it is created here.
ARG USERNAME=ubuntu
ARG USER_UID=1000
ARG USER_GID=1000
RUN if ! id -u "${USERNAME}" >/dev/null 2>&1; then \
        groupadd --gid "${USER_GID}" "${USERNAME}" && \
        useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home --shell /bin/bash "${USERNAME}"; \
    fi && \
    echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" && \
    chmod 0440 "/etc/sudoers.d/${USERNAME}" && \
    # Owned by the user so new build/install/log volumes inherit that ownership
    mkdir -p /ros2_ws/build /ros2_ws/install /ros2_ws/log && \
    chown -R "${USERNAME}:${USERNAME}" /ros2_ws && \
    echo "source /opt/ros/humble/setup.bash" >> "/home/${USERNAME}/.bashrc" && \
    echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" >> "/home/${USERNAME}/.bashrc"

# ── Stage 2: build ───────────────────────────────────────────
FROM deps AS build

# Workspace root — the entire repo is copied into src/Rolling-Bonxai/
WORKDIR /ros2_ws

COPY . src/Rolling-Bonxai/

# Resolve rosdep dependencies (skip packages without apt binaries)
RUN source /opt/ros/humble/setup.bash && \
    rosdep install \
        --from-paths src \
        --ignore-src \
        --rosdistro humble \
        -y \
        --skip-keys "libpcl-all-dev" \
    || true

# Full release build
RUN source /opt/ros/humble/setup.bash && \
    colcon build \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
        --event-handlers console_cohesion+

RUN echo "source /ros2_ws/install/setup.bash" >> /root/.bashrc

WORKDIR /ros2_ws
CMD ["bash"]
