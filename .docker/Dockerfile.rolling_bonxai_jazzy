# ============================================================
# .docker/Dockerfile.rolling_bonxai_jazzy
#
# ROS 2 Jazzy (Ubuntu 24.04 Noble) build of Rolling Bonxai.
#
# Use this when you want to develop / run Rolling Bonxai on
# Jazzy while the SITL container stays on Humble.  DDS
# (Fast-DDS / CycloneDDS) is wire-compatible between Humble and
# Jazzy on the same ROS_DOMAIN_ID, so topics cross the distro
# boundary transparently on network_mode: host.
#
# Two-stage build (same pattern as the Humble Dockerfile):
#   deps  — all apt deps, no source  (devcontainer uses this)
#   build — colcon build             (compose uses this)
#
# Build from repo root:
#   docker build -f .docker/Dockerfile.rolling_bonxai_jazzy \
#                --target build -t rolling_bonxai:jazzy .
# ============================================================

# ── Stage 1: deps ────────────────────────────────────────────
FROM ros:jazzy-ros-base AS deps

SHELL ["/bin/bash", "-o", "pipefail", "-o", "errexit", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# On Ubuntu 24.04 (Noble), gz-harmonic is available directly from
# the standard ROS apt repository — no separate OSRF key needed.
# ros-jazzy-ros-gz-bridge pulls gz-harmonic automatically.

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    build-essential \
    cmake \
    git \
    wget \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-pip \
    # ROS 2 Jazzy packages needed by rolling_bonxai_ros
    ros-jazzy-tf2-ros \
    ros-jazzy-tf2-eigen \
    ros-jazzy-sensor-msgs \
    ros-jazzy-geometry-msgs \
    ros-jazzy-visualization-msgs \
    ros-jazzy-pcl-conversions \
    ros-jazzy-std-srvs \
    ros-jazzy-rclcpp-components \
    ros-jazzy-foxglove-bridge \
    # Bag tooling for datasets/ (TartanGround -> MCAP)
    ros-jazzy-rosbag2 \
    ros-jazzy-rosbag2-storage-mcap \
    python3-numpy \
    # Experiment pipeline: plots (plot_stats.py), CPU profiling (perf; run_experiments.py --perf)
    # and a GUI to browse the profiles (hotspot; under Wayland run it with QT_QPA_PLATFORM=wayland)
    python3-matplotlib \
    linux-tools-common \
    linux-tools-generic \
    hotspot \
    # Gazebo Harmonic bridge (for /clock topic relay from SITL)
    ros-jazzy-ros-gz-bridge \
    # C++ dependencies
    libeigen3-dev \
    libpcl-dev \
    libyaml-cpp-dev \
    libboost-all-dev \
    # Debug tools
    gdb \
    # Lets the non-root dev user install packages (rosdep install uses sudo)
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Dataset downloads (datasets/scripts/download_tartanground.py): huggingface_hub only, no torch/CUDA
RUN pip3 install --no-cache-dir --break-system-packages "huggingface_hub==1.33.0"

# Ubuntu's `perf` wrapper only runs on Ubuntu kernels (it looks for /usr/lib/linux-tools/$(uname -r));
# point `perf` straight at the installed binary so it also works on other host kernels.
RUN ln -sf "$(ls -d /usr/lib/linux-tools/*/perf | sort -V | tail -1)" /usr/local/bin/perf

RUN rosdep init 2>/dev/null || true && rosdep update

RUN echo "source /opt/ros/jazzy/setup.bash" >> /root/.bashrc && \
    echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" \
         >> /root/.bashrc

# Non-root dev user, so files created in the bind-mounted repo belong to the host user, not root.
# The devcontainer runs as this user (remoteUser) and remaps its uid to the host's (updateRemoteUserUID).
# Ubuntu 24.04 images already ship `ubuntu` (uid 1000); on 22.04 it is created here.
ARG USERNAME=ubuntu
ARG USER_UID=1000
ARG USER_GID=1000
RUN if ! id -u "${USERNAME}" >/dev/null 2>&1; then \
        groupadd --gid "${USER_GID}" "${USERNAME}" && \
        useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home --shell /bin/bash "${USERNAME}"; \
    fi && \
    echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" && \
    chmod 0440 "/etc/sudoers.d/${USERNAME}" && \
    # Owned by the user so new build/install/log volumes inherit that ownership
    mkdir -p /ros2_ws/build /ros2_ws/install /ros2_ws/log && \
    chown -R "${USERNAME}:${USERNAME}" /ros2_ws && \
    echo "source /opt/ros/jazzy/setup.bash" >> "/home/${USERNAME}/.bashrc" && \
    echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" >> "/home/${USERNAME}/.bashrc"

# ── Stage 2: build ───────────────────────────────────────────
FROM deps AS build

WORKDIR /ros2_ws

COPY . src/Rolling-Bonxai/

RUN source /opt/ros/jazzy/setup.bash && \
    rosdep install \
        --from-paths src \
        --ignore-src \
        --rosdistro jazzy \
        -y \
        --skip-keys "libpcl-all-dev" \
    || true

RUN source /opt/ros/jazzy/setup.bash && \
    colcon build \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
        --event-handlers console_cohesion+

RUN echo "source /ros2_ws/install/setup.bash" >> /root/.bashrc

WORKDIR /ros2_ws
CMD ["bash"]
